{
----------------------------------------------------------------------------------------------------
    Filename:       SHT3x-Demo.spin2
    Description:    Demo of the SHT3x driver
        * Temp/RH data output
    Author:         Jesse Burt
    Started:        Nov 3, 2019
    Updated:        Aug 30, 2024
    Copyright (c) 2024 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}

CON

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000


OBJ

    ser:    "com.serial.terminal.ansi" | SER_BAUD=115_200
    sensor: "sensor.temp_rh.sht3x" | SCL=0, SDA=1, I2C_FREQ=400_000, I2C_ADDR=0, RST=2


PUB main() | rh, temp, tscl

    setup()

    sensor.temp_scale(sensor.C)                 ' C, F

    repeat
        sensor.measure()
        rh := sensor.rh()
        temp := sensor.temperature()
        ser.pos_xy(0, 3)
        ser.printf(@"Rel. humidity (%%): %3.3d.%02.2d\n\r", (rh / 100), (rh // 100))
        tscl := lookupz(sensor.temp_scale(): "C", "F", "K")
        ser.printf(@"Temp. (deg %c): %3.3d.%02.2d\n\r", tscl, (temp / 100), abs(temp // 100))



PUB setup()

    ser.start()

    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( sensor.start() )
        ser.strln(@"SHT3x driver started")
    else
        ser.strln(@"SHT3x driver failed to start - halting")
        repeat


DAT
